# Copy to .env for local runs. In Dokploy, paste these into the app's Environment tab.
# NEVER commit the real .env.

DISCORD_TOKEN=paste-bot-token-here
CHANNEL_ID=123456789012345678
# Optional. Uncomment / set to also poll New-Grad-Positions into a second channel.
# NEWGRAD_CHANNEL_ID=123456789012345678
# NEWGRAD_FEED_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/.github/scripts/listings.json

# Comma-separated. A posting matches if any of its terms is listed.
TERMS=Summer 2027
# Software, Hardware, AI/ML/Data, Product, Quant  (empty = all)
CATEGORIES=Software,Hardware,Quant

# Postings from ANY category whose title contains one of these words are also
# posted, labeled Finance/Business. Leave unset to use the built-in list in
# bot/config.py; set to empty to disable.
# TITLE_KEYWORDS=finance,banking,accounting,consulting,...

# Same for mechanical/manufacturing/systems roles, labeled Engineering (checked first).
# ENGINEERING_KEYWORDS=mechanical,manufacturing,robotics,aerospace,...

# Only post postings with at least one US location (default true).
US_ONLY=true

POLL_MINUTES=15
MAX_POSTS_PER_CYCLE=25
MAX_AGE_DAYS=14
# On first boot, post this many of the newest matches so the channel isn't empty.
SEED_POST_LATEST=0
LOG_LEVEL=INFO
